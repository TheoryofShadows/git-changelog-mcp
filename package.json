{
  "name": "@mcpx-digital/git-changelog",
  "version": "0.1.0",
  "description": "MCP server that generates release notes and CHANGELOG.md drafts from local git history with conventional-commit grouping. Local git repos only.",
  "type": "module",
  "bin": {
    "git-changelog-mcp": "./index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/*.test.js"
  },
  "files": [
    "index.js",
    "lib.js",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "git",
    "changelog",
    "release-notes",
    "conventional-commits",
    "mcpx"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheoryofShadows/git-changelog-mcp.git"
  },
  "homepage": "https://github.com/TheoryofShadows/git-changelog-mcp#readme",
  "author": "TheoryofShadows",
  "bugs": {
    "url": "https://github.com/TheoryofShadows/git-changelog-mcp/issues"
  }
}
